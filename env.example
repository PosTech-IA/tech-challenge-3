# ==============================================================================
# CONFIGURAÇÕES DO PROJETO - Tech Challenge 3
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
# cp env.example .env

# ==============================================================================
# CONFIGURAÇÕES DO MODELO LoRA
# ==============================================================================

# Caminho onde o modelo LoRA será salvo/carregado
# Linux/macOS/WSL: use caminhos absolutos ou relativos (ex: ./lora_model_qwen3_medquad)
# Windows (PowerShell): use caminhos absolutos (ex: C:\projetos\tech-challenge-3\lora_model_qwen3_medquad)
# WSL: use caminhos Linux (ex: ~/models/lora_model_qwen3_medquad ou ./lora_model_qwen3_medquad)
LORA_ADAPTER_PATH=./lora_model_qwen3_medquad

# Modelo base do HuggingFace para usar
# Opções comuns: unsloth/Qwen3-1.7B, unsloth/Qwen2.5-7B-Instruct, etc.
MODEL_BASE=unsloth/Qwen3-1.7B

# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ==============================================================================

# Host do banco de dados (use 'localhost' para Docker local, ou IP/domínio para remoto)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Nome do banco de dados
DB_NAME=atividade3-fiap

# Usuário do banco de dados
DB_USER=user

# Senha do banco de dados
DB_PASSWORD=password

# ==============================================================================
# CONFIGURAÇÕES DO DOCKER COMPOSE
# ==============================================================================

# Nome do container PostgreSQL
POSTGRES_CONTAINER_NAME=postgres-atividade3-fiap

# Versão da imagem PostgreSQL (ex: postgres:16-alpine)
POSTGRES_IMAGE=postgres:16-alpine

# ==============================================================================
# CONFIGURAÇÕES DO AGENTE
# ==============================================================================

# Modo de execução do agente
# TESTE: Executa queries pré-definidas e encerra
# INTERATIVO: Modo chat interativo
AGENT_MODE=TESTE

# ==============================================================================
# CONFIGURAÇÕES DE LOGGING
# ==============================================================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Diretório onde os logs serão salvos
LOG_DIR=logs

# ==============================================================================
# CONFIGURAÇÕES DO MODELO (Avançado)
# ==============================================================================

# Comprimento máximo de sequência para o modelo
MAX_SEQ_LENGTH=2048

# Usar quantização 4-bit (reduz uso de memória)
LOAD_IN_4BIT=true

# Device map para carregamento do modelo (auto, cpu, cuda:0, etc.)
DEVICE_MAP=auto

# ==============================================================================
# CONFIGURAÇÕES DE TREINAMENTO LoRA (Opcional - usado apenas nos scripts de treinamento)
# ==============================================================================

# Caminho do dataset para treinamento (formato JSONL)
# DATASET_PATH=./dataset_medquad_ft.jsonl

# Configurações de treinamento
# LORA_R=16
# LORA_ALPHA=16
# LORA_DROPOUT=0
# LEARNING_RATE=2e-4
# BATCH_SIZE=1
# GRADIENT_ACCUMULATION_STEPS=4
# MAX_STEPS=60

